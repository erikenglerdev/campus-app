{
  "kind": "collectionType",
  "collectionName": "news_channels",
  "info": {
    "singularName": "news-channel",
    "pluralName": "news-channels",
    "displayName": "News Channel",
    "description": "A selectable news channel. Channels are fully dynamic: adding one here makes it appear in the app without any code change."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 80,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 80,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "description": {
      "type": "text",
      "maxLength": 500,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "iconKey": {
      "type": "string",
      "required": true,
      "default": "channel",
      "maxLength": 60,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "colorHex": {
      "type": "string",
      "required": true,
      "default": "#5B3FD0",
      "minLength": 7,
      "maxLength": 7,
      "regex": "^#[0-9A-Fa-f]{6}$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "defaultSubscribed": {
      "type": "boolean",
      "default": false,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::news-article.news-article",
      "mappedBy": "channels"
    }
  }
}
