# Campus Köthen — Strapi CMS environment template
#
# Copy to `.env` and fill in real values. NEVER commit a filled-in `.env`.
# Generate every secret yourself, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=1337
# Public URL Strapi is reached under. Required behind a reverse proxy.
# PUBLIC_URL=https://cms-dev.<domain>

# --- Secrets (generate unique values per environment) ------------------------
# Two or more comma-separated keys.
APP_KEYS=REPLACE_ME_KEY_1,REPLACE_ME_KEY_2
API_TOKEN_SALT=REPLACE_ME
ADMIN_JWT_SECRET=REPLACE_ME
TRANSFER_TOKEN_SALT=REPLACE_ME
JWT_SECRET=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME

# --- Database ---------------------------------------------------------------
# The CMS uses its OWN database and its OWN role, separate from the app database.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=campus_cms_local
DATABASE_USERNAME=campus_cms
DATABASE_PASSWORD=REPLACE_ME
DATABASE_SSL=false
DATABASE_SCHEMA=public

# --- Internationalisation ---------------------------------------------------
# Default locale of the CMS. Content is maintained in `de` and `en`.
STRAPI_DEFAULT_LOCALE=de

# --- Seeding ----------------------------------------------------------------
# Set to `true` to allow the idempotent development seed to run.
SEED_DEMO_CONTENT=false
