// Campus Köthen — operational database (campus_app_<env>)
//
// This database holds ONLY imported canteen data and synchronisation state.
// Editorial content lives in Strapi and is never mirrored here.
//
// Money is Decimal, never Float.
// The source image URL (food.image_url) is deliberately NOT modelled: canteen
// images are not used anywhere in this project.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` here. The migration connection string lives
// in prisma.config.ts; the runtime client uses the @prisma/adapter-pg driver
// adapter (see src/prisma/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

/// A canteen. Seeded idempotently from canteens.config.ts so that adding a
/// canteen needs a backend config change and a deployment — never an app release.
model Canteen {
  id               String  @id @default(uuid())
  /// Stable public identifier used by the API and the app.
  slug             String  @unique
  /// location_id of the upstream source. Never exposed through the API.
  sourceLocationId Int     @unique
  displayNameDe    String
  displayNameEn    String
  campusLabelDe    String
  campusLabelEn    String
  active           Boolean @default(true)
  sortOrder        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals    Meal[]
  syncRuns SyncRun[]

  @@index([active, sortOrder])
  @@map("canteens")
}

/// A single dish on a single day at a single canteen.
model Meal {
  id String @id @default(uuid())

  /// Stable upsert key: `data[].id` from the source. Guarantees that repeating
  /// an import updates rather than duplicates.
  sourcePlanId Int  @unique
  sourceFoodId Int?

  canteenId String
  canteen   Canteen @relation(fields: [canteenId], references: [id], onDelete: Cascade)

  /// Calendar date, no time component.
  date      DateTime @db.Date
  counterId Int?
  isSprint  Boolean  @default(false)

  /// Text exactly as provided by the German-language source. Never translated.
  name     String
  subtitle String?

  /// Non-empty extra_1..extra_4 values.
  extras String[] @default([])

  /// Raw codes from `food.ingredients`. NOTE: the source mixes ingredient codes
  /// and marker codes in this one array, so resolution must consult both
  /// dictionaries — see IngredientDefinition.kind.
  ingredientCodes String[] @default([])

  prices MealPrice[]

  sourceUpdatedAt DateTime?
  importedAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([canteenId, date])
  @@index([date])
  @@map("meals")
}

/// One price group of one meal. Modelled relationally so that ALL price groups
/// the source offers are stored, and a missing group is simply an absent row —
/// no price is ever estimated or defaulted.
model MealPrice {
  id     String @id @default(uuid())
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  /// Stable technical key: "student" | "employee" | "guest".
  group  String
  /// Money as Decimal — never Float.
  amount Decimal @db.Decimal(6, 2)

  @@unique([mealId, group])
  @@map("meal_prices")
}

/// Label dictionary for ingredient and marker codes, imported from `meta`.
/// The source publishes German labels only; labelEn stays null unless a
/// human-maintained translation exists. Nothing is machine-translated.
model IngredientDefinition {
  code    String  @id
  labelDe String
  labelEn String?
  /// "ingredient" | "marker"
  kind    String

  updatedAt DateTime @updatedAt

  @@map("ingredient_definitions")
}

/// Audit trail of every synchronisation attempt. `lastSuccessfulSyncAt` is
/// derived from the most recent run with status = "success".
model SyncRun {
  id     String @id @default(uuid())
  source String @default("meine-mensa")

  canteenId String?
  canteen   Canteen? @relation(fields: [canteenId], references: [id], onDelete: SetNull)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// "running" | "success" | "empty" | "failed"
  status String

  recordsReceived Int @default(0)
  recordsUpserted Int @default(0)
  recordsRejected Int @default(0)

  /// Short, non-sensitive error summary. Never contains tokens or URLs with credentials.
  errorMessage String?

  @@index([canteenId, status, startedAt])
  @@index([status, startedAt])
  @@map("sync_runs")
}

// ---------------------------------------------------------------------------
// Timetable (WebUntis public view)
//
// Imported operational data, exactly like the canteen models: the source is a
// third party, so nothing here is authored by us and everything is replaceable
// by a re-import. External identifiers are stored so upserts stay stable, but
// they are NEVER exposed through the API — clients only ever see Campus UUIDs.
// ---------------------------------------------------------------------------

/// The current school year as reported by the source. Its id is dynamic and
/// changes every term, so it is resolved at runtime and never hardcoded.
model TimetableContext {
  id String @id @default(uuid())

  source String @default("webuntis")
  /// External school year id. Server-side only.
  externalId String
  name       String

  validFrom DateTime @db.Date
  validTo   DateTime @db.Date

  active           Boolean   @default(true)
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([source, active])
  @@map("timetable_contexts")
}

/// A class group offered by the public view. The UUID is the stable public
/// identifier; `externalId` never leaves the server.
model TimetableGroup {
  id String @id @default(uuid())

  source     String @default("webuntis")
  externalId String

  shortName  String
  longName   String
  department String?

  active     Boolean  @default(true)
  /// Last successful catalogue run that still contained this group. A group is
  /// only deactivated after a COMPLETE successful catalogue import.
  lastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries TimetableEntryGroup[]

  @@unique([source, externalId])
  @@index([active, shortName])
  @@index([department])
  @@map("timetable_groups")
}

/// One scheduled lesson. Shared by however many groups attend it.
model TimetableEntry {
  id String @id @default(uuid())

  source String @default("webuntis")
  /// Stable upsert key derived from the source's `ids[]`. Repeating an import
  /// therefore updates rather than duplicates.
  externalKey String

  /// Absolute instants. The source sends zone-less Europe/Berlin wall clock,
  /// which is converted on import — storing it raw would shift every lesson.
  startsAt DateTime
  endsAt   DateTime
  /// Calendar date in the source's zone, kept for cheap per-day queries.
  date     DateTime @db.Date

  title       String
  subjectCode String?

  /// Normalised: regular_teaching | additional | unknown
  type String
  /// Normalised: regular | changed | cancelled | unknown
  status String
  /// The untouched upstream value, so a new vocabulary can be diagnosed later
  /// without re-reading the source.
  sourceStatus String?

  /// Denormalised on purpose: teachers and rooms are display-only strings from
  /// the source, never entities we own or reconcile.
  teachers Json @default("[]")
  rooms    Json @default("[]")

  note String?

  importedAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  groups TimetableEntryGroup[]

  @@unique([source, externalKey])
  @@index([date])
  @@index([startsAt])
  @@map("timetable_entries")
}

/// Explicit many-to-many. Without it, syncing one group could delete a lesson
/// that other groups still attend.
model TimetableEntryGroup {
  entryId String
  groupId String

  entry TimetableEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  group TimetableGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([entryId, groupId])
  @@index([groupId])
  @@map("timetable_entry_groups")
}

/// Audit trail. `lastSuccessfulSyncAt` and staleness are derived from this.
model TimetableSyncRun {
  id String @id @default(uuid())

  source String @default("webuntis")
  /// context | groups | entries
  kind String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// running | success | empty | partial | failed | disabled
  status String

  /// Confirmed window, for entry runs.
  rangeFrom DateTime? @db.Date
  rangeTo   DateTime? @db.Date

  groupsRequested Int @default(0)
  recordsReceived Int @default(0)
  recordsAccepted Int @default(0)
  recordsRejected Int @default(0)
  recordsWritten  Int @default(0)
  recordsRemoved  Int @default(0)

  /// Classification only. Never a header, URL, raw payload or person's name.
  errorCode    String?
  errorMessage String?

  @@index([kind, status, startedAt])
  @@index([status, startedAt])
  @@map("timetable_sync_runs")
}
