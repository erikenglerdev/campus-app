# Campus Koethen DEV on eriklabs.eu
# This committed file intentionally contains all non-secret values for our VPS.
# Copy it to `.env`, set the empty credentials locally, and never commit `.env`.

# --- Compose and published images -------------------------------------------
COMPOSE_PROJECT_NAME=campus-koethen-dev
CONTAINER_PLATFORM=linux/amd64
RESTART_POLICY=unless-stopped
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5

CMS_IMAGE_REPOSITORY=ghcr.io/erikenglerdev/campus-app-cms
BACKEND_IMAGE_REPOSITORY=ghcr.io/erikenglerdev/campus-app-backend

# Not a credential. Set this to `sha-<full commit SHA>` only after the Images
# workflow for that main-branch commit has completed successfully.
CAMPUS_IMAGE_TAG=

# --- Public addresses and host bindings ------------------------------------
CMS_PUBLIC_URL=https://strapi-dev.eriklabs.eu
API_PUBLIC_URL=https://campus-backend-dev.eriklabs.eu

# Nginx runs on the host and proxies these loopback-only ports.
CMS_BIND_ADDRESS=127.0.0.1
CMS_HOST_PORT=3020
CMS_CONTAINER_PORT=1337
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=3021
API_CONTAINER_PORT=3000

# The Campus app is currently native. This explicit value satisfies the
# production allowlist without opening the API to arbitrary browser origins.
# Add future browser frontends here, comma-separated, using their exact origins.
CORS_ALLOWED_ORIGINS=https://campus-backend-dev.eriklabs.eu

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_PORT=5432
POSTGRES_ADMIN_USERNAME=campus_admin
POSTGRES_ADMIN_DATABASE=postgres

# Credential: generate once on the VPS with `openssl rand -hex 32`. Keep the
# existing value when an existing PostgreSQL volume is reused.
POSTGRES_ADMIN_PASSWORD=

CMS_DATABASE_NAME=campus_cms_dev
CMS_DATABASE_USERNAME=campus_cms
CMS_DATABASE_SCHEMA=public

# Credential: generate once with `openssl rand -hex 32`.
CMS_DATABASE_PASSWORD=

APP_DATABASE_NAME=campus_app_dev
APP_DATABASE_USERNAME=campus_app
APP_DATABASE_SCHEMA=public

# Credential: generate once with `openssl rand -hex 32`. Hex avoids URL
# escaping problems in the backend's PostgreSQL connection URL.
APP_DATABASE_PASSWORD=

# --- Strapi -----------------------------------------------------------------
BACKEND_STRAPI_BASE_URL=http://cms:1337
STRAPI_DEFAULT_LOCALE=de
STRAPI_TELEMETRY_DISABLED=true
SEED_DEMO_CONTENT=false
CMS_DATABASE_POOL_MIN=2
CMS_DATABASE_POOL_MAX=10
CMS_DATABASE_CONNECTION_TIMEOUT=60000

# Credentials: generate four separate values with `openssl rand -hex 32` and
# enter them as one comma-separated line. Keep them stable after first use.
STRAPI_APP_KEYS=

# Credential: generate once with `openssl rand -hex 32`.
STRAPI_API_TOKEN_SALT=

# Credential: generate once with `openssl rand -hex 32`.
STRAPI_ADMIN_JWT_SECRET=

# Credential: generate once with `openssl rand -hex 32`.
STRAPI_TRANSFER_TOKEN_SALT=

# Credential: generate once with `openssl rand -hex 32`.
STRAPI_JWT_SECRET=

# Credential: generate once with `openssl rand -hex 32`.
STRAPI_ENCRYPTION_KEY=

# Credential: initially leave empty. After the CMS starts, create a read-only
# token in Strapi Admin, insert it here, and recreate API and worker. Never
# enable general content permissions for Strapi's Public role.
STRAPI_API_TOKEN=
STRAPI_TIMEOUT_MS=10000
STRAPI_RETRY_ATTEMPTS=2

# --- Canteen ---------------------------------------------------------------
CANTEEN_SOURCE_URL=https://meine-mensa.de/api/food_plans
CANTEEN_HTTP_TIMEOUT_MS=15000
CANTEEN_RETRY_ATTEMPTS=3
CANTEEN_REQUEST_SPACING_MS=1000
CANTEEN_SYNC_CRON="0 */2 * * *"
CANTEEN_SYNC_ON_BOOT=false
CANTEEN_STALE_AFTER_MINUTES=240
CANTEEN_SYNC_DAYS_AHEAD=14

# --- WebUntis --------------------------------------------------------------
# Disabled in the committed template until automated use has been deliberately
# cleared. Enable only in the private VPS `.env` after that decision.
WEBUNTIS_ENABLED=false
WEBUNTIS_BASE_URL=https://hsa.webuntis.com/WebUntis/api/rest/view/v1
WEBUNTIS_ANONYMOUS_SCHOOL=hsa
WEBUNTIS_HTTP_TIMEOUT_MS=20000
WEBUNTIS_RETRY_ATTEMPTS=3
WEBUNTIS_REQUEST_SPACING_MS=1500
WEBUNTIS_MAX_RESPONSE_BYTES=16000000
WEBUNTIS_GROUP_SYNC_CRON="0 3,15 * * *"
WEBUNTIS_ENTRY_SYNC_CRON="0 * * * *"
WEBUNTIS_SYNC_ON_BOOT=false
WEBUNTIS_LOOKBACK_DAYS=7
WEBUNTIS_LOOKAHEAD_DAYS=28
WEBUNTIS_STALE_AFTER_MINUTES=180

# --- Public Google calendars via public ICS -------------------------------
# No Google credential is required. Keep this off until the corresponding
# public calendar definitions have been created and published in Strapi.
PUBLIC_CALENDAR_ENABLED=false
PUBLIC_CALENDAR_HTTP_TIMEOUT_MS=20000
PUBLIC_CALENDAR_RETRY_ATTEMPTS=2
PUBLIC_CALENDAR_REQUEST_SPACING_MS=1000
PUBLIC_CALENDAR_CATALOG_SYNC_CRON="*/10 * * * *"
PUBLIC_CALENDAR_EVENT_SYNC_CRON="*/10 * * * *"
PUBLIC_CALENDAR_SYNC_ON_BOOT=false
PUBLIC_CALENDAR_MAX_FEED_BYTES=8000000
PUBLIC_CALENDAR_MAX_EVENTS=5000
PUBLIC_CALENDAR_MAX_OCCURRENCES=10000
PUBLIC_CALENDAR_MAX_OCCURRENCES_PER_EVENT=750
PUBLIC_CALENDAR_MAX_TEXT_LENGTH=2000
PUBLIC_CALENDAR_LOOKBACK_DAYS=30
PUBLIC_CALENDAR_LOOKAHEAD_DAYS=180
PUBLIC_CALENDAR_STALE_AFTER_MINUTES=720
PUBLIC_CALENDAR_FALLBACK_TIME_ZONE=Europe/Berlin
PUBLIC_CALENDAR_USER_AGENT="CampusKoethen/1.0 (+https://campus-backend-dev.eriklabs.eu)"
PUBLIC_CALENDAR_API_MAX_CALENDARS=50
PUBLIC_CALENDAR_API_MAX_RANGE_DAYS=120

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false
