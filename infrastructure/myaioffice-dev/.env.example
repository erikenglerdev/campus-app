# Campus Köthen — DEV deployment environment template
# Copy to `.env` on the server, set mode 0600, and replace every placeholder.
# Never commit or paste the filled file into logs, issues, or chats.

COMPOSE_PROJECT_NAME=campus-koethen-dev

# Immutable tags published by the Images workflow. Use the same commit SHA for
# CMS and backend so the deployed monorepo contract stays coherent.
CMS_IMAGE_TAG=sha-REPLACE_WITH_FULL_COMMIT_SHA
BACKEND_IMAGE_TAG=sha-REPLACE_WITH_FULL_COMMIT_SHA

# PostgreSQL bootstrap and the two isolated application roles.
POSTGRES_ADMIN_PASSWORD=REPLACE_ME
CMS_DB_PASSWORD=REPLACE_ME
APP_DB_PASSWORD=REPLACE_ME

# Strapi runtime secrets. Generate independent values for each environment.
STRAPI_APP_KEYS=REPLACE_ME_KEY_1,REPLACE_ME_KEY_2,REPLACE_ME_KEY_3,REPLACE_ME_KEY_4
STRAPI_API_TOKEN_SALT=REPLACE_ME
STRAPI_ADMIN_JWT_SECRET=REPLACE_ME
STRAPI_TRANSFER_TOKEN_SALT=REPLACE_ME
STRAPI_JWT_SECRET=REPLACE_ME
STRAPI_ENCRYPTION_KEY=REPLACE_ME

# Read-only token created after the first Strapi bootstrap. The Public Role
# remains without permissions. Do not start API/worker with this placeholder.
STRAPI_API_TOKEN=REPLACE_AFTER_STRAPI_BOOTSTRAP
STRAPI_TIMEOUT_MS=10000
STRAPI_RETRY_ATTEMPTS=2

# Explicit production-mode allowlist; wildcard is rejected by the backend.
CORS_ALLOWED_ORIGINS=https://api-dev.myaioffice.de
LOG_LEVEL=info

# Mensa worker.
# IANA timezone used for all worker cron schedules.
WORKER_TIME_ZONE=UTC
CANTEEN_SYNC_CRON="0 */2 * * *"
CANTEEN_SYNC_ON_BOOT=false

# Public calendars. Safer template defaults stay off; enable deliberately in
# the real server `.env` after Strapi definitions and rights are ready.
PUBLIC_CALENDAR_ENABLED=false
PUBLIC_CALENDAR_CATALOG_SYNC_CRON="*/10 * * * *"
PUBLIC_CALENDAR_EVENT_SYNC_CRON="*/10 * * * *"
PUBLIC_CALENDAR_SYNC_ON_BOOT=false
PUBLIC_CALENDAR_STALE_AFTER_MINUTES=720
PUBLIC_CALENDAR_API_MAX_CALENDARS=50
PUBLIC_CALENDAR_API_MAX_RANGE_DAYS=120

# Public WebUntis view. Disabled until automated use is cleared.
WEBUNTIS_ENABLED=false
WEBUNTIS_BASE_URL=https://hsa.webuntis.com/WebUntis/api/rest/view/v1
WEBUNTIS_ANONYMOUS_SCHOOL=hsa
WEBUNTIS_GROUP_SYNC_CRON="0 3,15 * * *"
WEBUNTIS_ENTRY_SYNC_CRON="0 * * * *"
WEBUNTIS_SYNC_ON_BOOT=false
WEBUNTIS_LOOKBACK_DAYS=7
WEBUNTIS_LOOKAHEAD_DAYS=28
WEBUNTIS_STALE_AFTER_MINUTES=180
