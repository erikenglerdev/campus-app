# Campus Köthen — DEV deployment environment template
#
# Copy to `.env` ON THE SERVER and fill in real values there.
# Never commit a filled-in file. Never copy server passwords into this
# repository, a chat, an issue or a CI log.
#
# Generate a fresh secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Image tags -------------------------------------------------------------
# Use an IMMUTABLE tag from the Images workflow: sha-<full commit sha>.
# `main` and `dev` move and must not be used for a reproducible rollout.
CMS_IMAGE_TAG=sha-REPLACE_WITH_FULL_COMMIT_SHA
BACKEND_IMAGE_TAG=sha-REPLACE_WITH_FULL_COMMIT_SHA

# --- Existing server database ----------------------------------------------
# The PostgreSQL 16 instance already running on the host. From inside a
# container the host is usually reachable as host.docker.internal (with
# extra_hosts) or via the docker bridge gateway — use whatever the server is
# already configured for. PostgreSQL must stay bound to loopback.
DB_HOST=REPLACE_ME
DB_PORT=5432
DB_SSL=false

# Passwords for campus_cms and campus_app. These exist ONLY on the server.
CMS_DB_PASSWORD=REPLACE_ME
APP_DB_PASSWORD=REPLACE_ME

# --- Strapi secrets ---------------------------------------------------------
# Generate fresh values per environment. DEV and PROD never share secrets.
APP_KEYS=REPLACE_ME_KEY_1,REPLACE_ME_KEY_2
API_TOKEN_SALT=REPLACE_ME
ADMIN_JWT_SECRET=REPLACE_ME
TRANSFER_TOKEN_SALT=REPLACE_ME
JWT_SECRET=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME

# --- Campus API -------------------------------------------------------------
# Read-only token created in the Strapi admin UI, or via
#   docker compose exec cms node scripts/create-readonly-token.js
# The Strapi Public Role stays without any permissions.
STRAPI_API_TOKEN=REPLACE_ME

# Explicit origin allowlist. A wildcard is REJECTED when NODE_ENV=production.
CORS_ALLOWED_ORIGINS=https://api-dev.myaioffice.de

LOG_LEVEL=info

# --- Worker -----------------------------------------------------------------
CANTEEN_SYNC_CRON="0 */2 * * *"

# --- Stundenplan (öffentliche WebUntis-Ansicht) ------------------------------
# AUS per Default. Die Quelle ist eine interne Schnittstelle der öffentlichen
# WebUntis-Oberfläche; die automatisierte Nutzung ist noch nicht freigegeben.
# Erst nach bewusster Freigabe auf true setzen.
WEBUNTIS_ENABLED=false
WEBUNTIS_BASE_URL=https://hsa.webuntis.com/WebUntis/api/rest/view/v1
# Kein Credential, aber serverseitige Konfiguration: erreicht nie die App.
WEBUNTIS_ANONYMOUS_SCHOOL=hsa
WEBUNTIS_HTTP_TIMEOUT_MS=20000
WEBUNTIS_RETRY_ATTEMPTS=3
WEBUNTIS_REQUEST_SPACING_MS=1500
# Katalog 2x täglich, Einträge stündlich. Einträge für ALLE Gruppen kommen in
# EINEM Request — insgesamt rund 28 Fremdabrufe pro Tag.
WEBUNTIS_GROUP_SYNC_CRON="0 3,15 * * *"
WEBUNTIS_ENTRY_SYNC_CRON="0 * * * *"
WEBUNTIS_SYNC_ON_BOOT=false
WEBUNTIS_LOOKBACK_DAYS=7
WEBUNTIS_LOOKAHEAD_DAYS=28
WEBUNTIS_STALE_AFTER_MINUTES=180
