# Campus Köthen — local Compose environment template
#
# Copy to `.env` in this directory and replace every REPLACE_ME value.
# `.env` is git-ignored. NEVER commit real values.
#
# Generate a value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Ports (all bound to 127.0.0.1 only) ------------------------------------
POSTGRES_PORT=5433
CMS_PORT=3020
API_PORT=3021

# --- Database passwords -----------------------------------------------------
# Bootstrap superuser, used only by the init scripts on first start.
POSTGRES_SUPERUSER_PASSWORD=REPLACE_ME_SUPERUSER_PASSWORD
# The two application roles. Neither is a superuser and neither can connect to
# the other's database.
APP_DB_PASSWORD=REPLACE_ME_APP_DB_PASSWORD
CMS_DB_PASSWORD=REPLACE_ME_CMS_DB_PASSWORD

# --- Strapi secrets (only needed for the `full` profile) --------------------
APP_KEYS=REPLACE_ME_KEY_1,REPLACE_ME_KEY_2
API_TOKEN_SALT=REPLACE_ME
ADMIN_JWT_SECRET=REPLACE_ME
TRANSFER_TOKEN_SALT=REPLACE_ME
JWT_SECRET=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME

# --- Backend ----------------------------------------------------------------
# Inside the compose network the CMS is reachable as http://cms:1337
STRAPI_BASE_URL=http://cms:1337
# Read-only token created in the Strapi admin UI. Leave empty until it exists;
# /health/ready will then report strapi as "degraded", which is expected.
STRAPI_API_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:3021,http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# --- Worker -----------------------------------------------------------------
# IANA timezone used for all worker cron schedules.
WORKER_TIME_ZONE=UTC
USER_TEST_DATA_ENABLED=false
CANTEEN_SYNC_CRON="0 */2 * * *"
# Set to true to run one sync immediately at worker start (handy locally).
CANTEEN_SYNC_ON_BOOT=false

# Idempotent de/en demo seed. Never enable on production.
SEED_DEMO_CONTENT=false

# --- Stundenplan (öffentliche WebUntis-Ansicht) ------------------------------
# AUS per Default. Die Quelle ist eine interne Schnittstelle der öffentlichen
# WebUntis-Oberfläche; die automatisierte Nutzung ist noch nicht freigegeben.
# Erst nach bewusster Freigabe auf true setzen.
WEBUNTIS_ENABLED=false
WEBUNTIS_BASE_URL=https://hsa.webuntis.com/WebUntis/api/rest/view/v1
# Kein Credential, aber serverseitige Konfiguration: erreicht nie die App.
WEBUNTIS_ANONYMOUS_SCHOOL=hsa
WEBUNTIS_HTTP_TIMEOUT_MS=20000
WEBUNTIS_RETRY_ATTEMPTS=3
WEBUNTIS_REQUEST_SPACING_MS=1500
# Katalog 2x täglich, Einträge stündlich. Einträge für ALLE Gruppen kommen in
# EINEM Request — insgesamt rund 28 Fremdabrufe pro Tag.
WEBUNTIS_GROUP_SYNC_CRON="0 3,15 * * *"
WEBUNTIS_ENTRY_SYNC_CRON="0 * * * *"
WEBUNTIS_SYNC_ON_BOOT=false
WEBUNTIS_LOOKBACK_DAYS=7
WEBUNTIS_LOOKAHEAD_DAYS=28
WEBUNTIS_STALE_AFTER_MINUTES=180
